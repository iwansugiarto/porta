default_platform(:android)

# Fastlane runs from the fastlane/ directory,
# so all paths are relative to that.
PROJECT_ROOT = File.expand_path("..", __dir__)
BUILD_GRADLE = File.join(PROJECT_ROOT, "app", "build.gradle.kts")

platform :android do

  # ── Build lanes ──

  desc "Build debug APK"
  lane :build_debug do
    gradle(
      task: "assemble",
      build_type: "Debug",
      project_dir: PROJECT_ROOT
    )
    UI.success "✅ Debug APK ready"
  end

  desc "Build release APK"
  lane :build_release do
    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: PROJECT_ROOT
    )
    UI.success "✅ Release APK ready"
  end

  desc "Build release AAB (for Play Store)"
  lane :build_aab do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: PROJECT_ROOT
    )
    UI.success "✅ Release AAB ready"
  end

  # ── Install lanes ──

  desc "Build and install debug APK on connected device"
  lane :install do
    gradle(
      task: "installDebug",
      project_dir: PROJECT_ROOT
    )
    UI.success "✅ Installed debug APK on device"
  end

  # ── Test lanes ──

  desc "Run unit tests"
  lane :test do
    gradle(
      task: "test",
      project_dir: PROJECT_ROOT
    )
  end

  desc "Run lint checks"
  lane :lint do
    gradle(
      task: "lint",
      build_type: "Debug",
      project_dir: PROJECT_ROOT
    )
  end

  # ── Version management ──

  desc "Bump version code and name"
  lane :bump_version do |options|
    build_file = File.read(BUILD_GRADLE)

    current_code = build_file.match(/versionCode\s*=\s*(\d+)/)[1].to_i
    current_name = build_file.match(/versionName\s*=\s*"([^"]+)"/)[1]

    new_code = current_code + 1

    parts = current_name.split(".")
    bump_type = options[:type] || "patch"
    case bump_type
    when "major"
      parts[0] = (parts[0].to_i + 1).to_s
      parts[1] = "0"
      parts[2] = "0"
    when "minor"
      parts[1] = (parts[1].to_i + 1).to_s
      parts[2] = "0"
    when "patch"
      parts[2] = (parts[2].to_i + 1).to_s
    end
    new_name = parts.join(".")

    build_file.gsub!(/versionCode\s*=\s*\d+/, "versionCode = #{new_code}")
    build_file.gsub!(/versionName\s*=\s*"[^"]+"/, "versionName = \"#{new_name}\"")
    File.write(BUILD_GRADLE, build_file)

    UI.success "✅ Version bumped: #{current_name} (#{current_code}) → #{new_name} (#{new_code})"
    { version_name: new_name, version_code: new_code }
  end

  # ── Alpha distribution ──

  desc "Alpha release: bump version → build signed APK → install on device"
  lane :alpha do |options|
    # 1. Bump version
    version = bump_version(type: options[:bump] || "patch")

    # 2. Build signed release APK
    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: PROJECT_ROOT
    )

    apk_path = File.join(PROJECT_ROOT, "app/build/outputs/apk/release/app-release.apk")
    UI.success "✅ Alpha APK built: #{apk_path}"

    # 3. Install on connected device (if available)
    begin
      gradle(
        task: "installRelease",
        project_dir: PROJECT_ROOT
      )
      UI.success "✅ Installed on device"
    rescue => e
      UI.important "⚠️  No device connected, skipping install: #{e.message}"
    end

    # 4. Git tag the alpha release
    version_name = version[:version_name]
    version_code = version[:version_code]
    tag = "alpha/v#{version_name}-#{version_code}"

    git_add(path: BUILD_GRADLE)
    git_commit(
      path: BUILD_GRADLE,
      message: "chore(rokid): alpha release v#{version_name} (#{version_code})"
    )
    add_git_tag(tag: tag)

    UI.success "🏷️  Tagged: #{tag}"
    UI.success "🚀 Alpha v#{version_name} (#{version_code}) ready!"
    UI.message ""
    UI.message "  APK:  #{apk_path}"
    UI.message "  Tag:  #{tag}"
    UI.message ""
    UI.message "  Push with: git push && git push origin #{tag}"
  end

  # ── Distribution lanes ──

  desc "Build and deploy to Firebase App Distribution"
  lane :firebase do |options|
    build_debug

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID"],
      groups: options[:groups] || "testers",
      release_notes: options[:notes] || changelog_from_git_commits(commits_count: 5, pretty: "- %s")
    )
  end

  desc "Deploy alpha to Play Store alpha track"
  lane :deploy_alpha do
    build_aab

    supply(
      track: "alpha",
      aab: File.join(PROJECT_ROOT, "app/build/outputs/bundle/release/app-release.aab"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft"
    )
    UI.success "✅ Deployed to Play Store alpha track"
  end

  desc "Deploy to Play Store internal testing track"
  lane :deploy_internal do
    build_aab

    supply(
      track: "internal",
      aab: File.join(PROJECT_ROOT, "app/build/outputs/bundle/release/app-release.aab"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    UI.success "✅ Deployed to Play Store internal track"
  end

  desc "Bump version → build AAB → deploy to Play Store internal track → git tag"
  lane :internal do |options|
    # 1. Bump version
    version = bump_version(type: options[:bump] || "patch")
    version_name = version[:version_name]
    version_code = version[:version_code]

    # 2. Build signed AAB
    build_aab

    # 3. Deploy to internal track
    supply(
      track: "internal",
      aab: File.join(PROJECT_ROOT, "app/build/outputs/bundle/release/app-release.aab"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    # 4. Git commit + tag
    tag = "internal/v#{version_name}-#{version_code}"
    git_add(path: BUILD_GRADLE)
    git_commit(
      path: BUILD_GRADLE,
      message: "chore(rokid): internal release v#{version_name} (#{version_code})"
    )
    add_git_tag(tag: tag)

    UI.success "🚀 Internal v#{version_name} (#{version_code}) published!"
    UI.message ""
    UI.message "  Tag:  #{tag}"
    UI.message "  Push with: git push && git push origin #{tag}"
  end

  desc "Promote internal to alpha"
  lane :promote_alpha do
    supply(
      track: "internal",
      track_promote_to: "alpha",
      skip_upload_changelogs: false
    )
    UI.success "✅ Promoted internal → alpha"
  end

  desc "Promote alpha to beta"
  lane :promote_beta do
    supply(
      track: "alpha",
      track_promote_to: "beta",
      skip_upload_changelogs: false
    )
    UI.success "✅ Promoted alpha → beta"
  end

  desc "Promote beta to production"
  lane :promote_production do |options|
    supply(
      track: "beta",
      track_promote_to: "production",
      rollout: options[:rollout] || "0.1",
      skip_upload_changelogs: false
    )
    UI.success "✅ Promoted beta → production (rollout: #{options[:rollout] || '10%'})"
  end

  # ── CI/CD helper ──

  desc "Full CI pipeline: lint → test → build"
  lane :ci do
    lint
    test
    build_release
    UI.success "✅ CI pipeline passed"
  end

end
