# ── Proxy (runtime, loaded via Node --env-file) ──
PORTA_HOST=127.0.0.1       # Loopback only; set to an explicit private LAN IP for home network use
PORTA_PORT=3170
PORTA_CORS_ORIGINS=        # Comma-separated allowed origins (e.g. https://porta.pages.dev)

# ── Authentication ──
# PORTA_AUTH_TOKEN=          # Shared secret for API access. All requests must include
#                            # Authorization: Bearer <token>. Leave unset to disable auth.
#                            # Strongly recommended when using LAN or remote (Cloudflare) access.
# PORTA_AUTH_USER=            # Username for password-based login (web UI)
# PORTA_AUTH_PASSWORD=        # Password for password-based login (web UI)
#                             # Supports bcrypt hashes: PORTA_AUTH_PASSWORD='$2b$10$...'
# PORTA_SESSION_TTL=24        # Session lifetime in hours (default: 24)
# PORTA_RATE_LIMIT=100       # Max API requests per minute per IP (default: 100)

# ── Agent Behavior ──
# PORTA_AUTO_APPROVE=true    # Auto-approve all tool operations (default: true)
#                            # Set to "false" to enable approval buttons for
#                            # unsafe commands and file access in the web UI.

# ── Cloudflare deployment (used by pnpm dev:cloud / pnpm deploy) ──
# PORTA_TUNNEL_NAME=       # cloudflared tunnel name (e.g. my-porta-tunnel)
# PORTA_CF_PROJECT=        # Cloudflare Pages project name (e.g. porta)

# ── Web (build-time, production only) ──
# VITE_API_BASE=           # Absolute API URL (e.g. https://api.example.com)
#                          # Leave unset for local dev — Vite's proxy handles /api/* routing

# ── Telegram Bot (optional — enable to bridge Antigravity to Telegram) ──
# TELEGRAM_BOT_TOKEN=          # Bot token from @BotFather
# TELEGRAM_ALLOWED_USERS=      # Comma-separated Telegram user IDs (e.g. 123456789,987654321)
#                               # Get your ID from @userinfobot. Required — empty = no one can use the bot.
# TELEGRAM_ALLOWED_GROUPS=     # Comma-separated Telegram group/supergroup IDs (optional)
#                               # Bot only responds in these groups. Omit to disable group use.
# TELEGRAM_WORKSPACE_URI=      # Default workspace URI for new conversations (optional)
#                               # e.g. file:///Users/you/dev/myproject
# ANTIGRAVITY_CLI_PATH=         # Path to the Antigravity CLI binary (optional)
#                               # Used by /workspace to launch inactive workspaces.
#                               # Default: /Applications/Antigravity.app/Contents/Resources/app/bin/antigravity
